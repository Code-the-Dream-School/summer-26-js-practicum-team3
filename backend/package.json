{
  "name": "basic-backend-api",
  "version": "1.1.0",
  "description": "Node + Express backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "npm run db:generate",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "db:generate": "npx prisma generate",
    "db:pull": "npx prisma db pull",
    "test": "vitest run",
    "test:joi": "vitest run joi",
    "test:recipe-api": "vitest run recipe",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "http-status-codes": "2.3.0",
    "joi": "18.2.3",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.11.0",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "morgan": "1.11.0",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  }
}
