{
  "name": "summer-26-js-practicum-team3",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "format:frontend": "npm run format --workspace=frontend",
    "format:backend": "npm run format --workspace=backend",
    "format": "concurrently \"npm:format:*\"",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint": "concurrently \"npm:lint:*\"",
    "init-env": "cp -n backend/.env.example backend/.env && cp -n frontend/.env.example frontend/.env",
    "db:generate": "npm run --workspace=backend db:generate",
    "db:pull": "npm run --workspace=backend db:pull",
    "test": "npm run --workspace=backend test",
    "test:joi": "npm run --workspace=backend test:joi",
    "test:recipe-api": "npm run --workspace=backend test:recipe-api",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "husky": "9.1.7",
    "prettier": "3.9.6"
  },
  "allowScripts": {
    "dompurify@3.4.13": true,
    "husky@9.1.7": true
  }
}
