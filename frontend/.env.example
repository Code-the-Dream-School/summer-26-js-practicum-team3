# Frontend env — defaults work out of the box for local dev.
# Copied to frontend/.env by `npm run init-env`.

# Port the Vite dev server runs on (pinned with strictPort).
VITE_PORT=8081

# Backend address the Vite proxy forwards every /api request to (dev only).
VITE_TARGET="http://localhost:8080"

# Origin prefix prepended to API paths.
# Empty = same-origin: call our own origin and let the proxy reach the backend.
# Set a full origin only to call a backend directly, bypassing the proxy.
VITE_API_ORIGIN=""
